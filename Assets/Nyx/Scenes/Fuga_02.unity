  fase: {fileID: 1417086826}
  trechos:
  - inicio: 64
    fim: 81.5
    setor: TRIAGEM
    titulo: "Uma pistola no ch\xE3o"
    dica: "Chegue perto dela e pressione <b>E</b>. H\xE1 espa\xE7o aqui para experimentar a mira."
    assunto: 5
    quadros:
    - {fileID: 2800000, guid: 133b0518b9f5aa641bdd3e91bd586ac5, type: 3}
    - {fileID: 2800000, guid: 318d9078bca47dd43b80aef6980adf0d, type: 3}
    - {fileID: 2800000, guid: d8531ae7b6722614bbbd308c9807a469, type: 3}
    - {fileID: 2800000, guid: 1ba1cc09567931d48a70ddb0246e4a4d, type: 3}
    - {fileID: 2800000, guid: f7bd9731874a9864d95e46ccc0e71e75, type: 3}
