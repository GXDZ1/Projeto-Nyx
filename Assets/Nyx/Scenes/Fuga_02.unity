    - {fileID: 2800000, guid: d5bce3639bb314d4e8f1bc9f7a69609e, type: 3}
    - {fileID: 2800000, guid: 5bb26617045bf514695ebf6f18714cf9, type: 3}
  - inicio: 81.5
    fim: 94.8
    setor: TRIAGEM
    titulo: Guarda com cassetete
    dica: "Ele precisa se aproximar para bater. Se aparecer um <b>!</b>, recue e mantenha dist\xE2ncia."
    assunto: 0
    quadros:
    - {fileID: 2800000, guid: aa294f4adcaa8bc48a98e6deee3c939b, type: 3}
    - {fileID: 2800000, guid: db2951ec8a5770a4f9937578b51166eb, type: 3}
    - {fileID: 2800000, guid: f31a4dd84f0b1e3458e29e1cc8f9ccbf, type: 3}
