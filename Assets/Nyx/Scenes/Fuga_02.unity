    - {fileID: 2800000, guid: 8cfcaffef42fab44ba1e97a4cf440ac1, type: 3}
    - {fileID: 2800000, guid: 6769be7a59ed7c64d8525f26e119f77d, type: 3}
    - {fileID: 2800000, guid: d73fa038de969694cab7451005435817, type: 3}
    - {fileID: 2800000, guid: ab4ba927a22cb8f4d9a8397d5505b81a, type: 3}
    - {fileID: 2800000, guid: a75f31375e54a734faf97e720652dce1, type: 3}
    - {fileID: 2800000, guid: b7e53234ff9c8d14d8decad2b02c9e09, type: 3}
    - {fileID: 2800000, guid: 0d2ebf82f593e14449af3a98168dad48, type: 3}
  - inicio: 136.5
    fim: 144
    setor: "VIGIL\xC2NCIA"
    titulo: Barreira a laser
    dica: O alarme avisa antes do feixe. Espere a luz e o laser apagarem para passar.
    assunto: 0
    quadros: []
  - inicio: 144
    fim: 177
    setor: "LABORAT\xD3RIO"
    titulo: Guarda antimotim
    dica: O escudo segura boa parte dos tiros pela frente. Passe por ele e atire pelas costas.
    assunto: 0
    quadros:
    - {fileID: 2800000, guid: ac43508a455a23b4cb4c382977e734f9, type: 3}
    - {fileID: 2800000, guid: 34a3fac89b959744dac9fd062dcc9064, type: 3}
    - {fileID: 2800000, guid: 7cefe2e979873db47b4155ece61dba3e, type: 3}
    - {fileID: 2800000, guid: 0dda276523af8c641bbec553007e823b, type: 3}
    - {fileID: 2800000, guid: 698db50337c2ca34fbfff36b240b10c1, type: 3}
    - {fileID: 2800000, guid: 85757ee7ad6a1f74ca9d32a8c51b2635, type: 3}
    - {fileID: 2800000, guid: 1b9ed167082ed6a49b6ec2fb26eacdbc, type: 3}
    - {fileID: 2800000, guid: 1c77c660727036741987d1ce2b3f3b78, type: 3}
    - {fileID: 2800000, guid: d80542972d2f1d2448123bb190743e84, type: 3}
    - {fileID: 2800000, guid: 3bc8e4ca4ff435d4a82df33ce5e5cc36, type: 3}
    - {fileID: 2800000, guid: 20df12b474a4d5a4c9e71e7c203069ef, type: 3}
    - {fileID: 2800000, guid: 72dbd66ba41e1104d8335c6e0909db87, type: 3}
    - {fileID: 2800000, guid: 6f7a4ab1fe4ea0b448c7284d3d1a838b, type: 3}
    - {fileID: 2800000, guid: ffb940b2aa3e2464daa9b5fdf0bb1a03, type: 3}
    - {fileID: 2800000, guid: 54ec9d55e80bf3b4db6ffee56c449878, type: 3}
  - inicio: 177
    fim: 186
    setor: "LABORAT\xD3RIO"
    titulo: "Sa\xEDda de vapor"
    dica: O bocal avisa antes de soltar vapor. Fique fora da grade, espere o jato parar e siga.
    assunto: 0
    quadros: []
  - inicio: 186
    fim: 218
    setor: "CONTEN\xC7\xC3O"
    titulo: Guarda socador
    dica: "Esse corre para encurtar a dist\xE2ncia. D\xEA espa\xE7o para tr\xE1s quando ele levantar os punhos."
    assunto: 0
    quadros:
    - {fileID: 2800000, guid: 0c2b815fbf3a87347a4c69718572bd2f, type: 3}
    - {fileID: 2800000, guid: c215ef9a531b73248bffacb50715bcf2, type: 3}
    - {fileID: 2800000, guid: cb60c19cc8025634798799ba0bbcf2ea, type: 3}
    - {fileID: 2800000, guid: 909daf55fa7a3c745bf2a0e1044e4f04, type: 3}
    - {fileID: 2800000, guid: 21e53df44e5adca4b8de88cb527b6c98, type: 3}
    - {fileID: 2800000, guid: 920933be5db3ac446b82270f7093e597, type: 3}
    - {fileID: 2800000, guid: 9456d8e052ef3214aa3bda431ca0a64b, type: 3}
    - {fileID: 2800000, guid: c4e415f118230354ea2712d2b6f675fd, type: 3}
    - {fileID: 2800000, guid: a51e8d08470eef34186d62f996878fdf, type: 3}
    - {fileID: 2800000, guid: a585d042339de5e42a6cd0a2ed0269ef, type: 3}
    - {fileID: 2800000, guid: 64ac78ceb2650ca438a045a5f0752a2d, type: 3}
    - {fileID: 2800000, guid: ea653e4196cde774fa6cbbbf18079653, type: 3}
    - {fileID: 2800000, guid: 9887529dea80987498674e0bcc4298f2, type: 3}
    - {fileID: 2800000, guid: 5dad8d924feaed24abde27ec7131d209, type: 3}
    - {fileID: 2800000, guid: 2fd7ff418716ea64b9d448c9bebf762c, type: 3}
  - inicio: 218
    fim: 228
    setor: "CONTEN\xC7\xC3O"
    titulo: Esmagador
    dica: "Quando o alarme piscar, espere. Passe assim que a cabe\xE7a come\xE7ar a voltar para o alto."
    assunto: 0
    quadros: []
  - inicio: 228
    fim: 254
    setor: "DOCA DE EVACUA\xC7\xC3O"
    titulo: Torreta
    dica: A linha vermelha mostra para onde ela mira. Use a caixa para se esconder ou saia da linha de tiro.
    assunto: 0
    quadros:
    - {fileID: 2800000, guid: e869ed85794106f4e90a2704868466b5, type: 3}
    - {fileID: 2800000, guid: a9ff3562283a94245a1878109ca776c3, type: 3}
