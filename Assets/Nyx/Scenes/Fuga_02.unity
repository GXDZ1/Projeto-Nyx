    - {fileID: 2800000, guid: 6f7a4ab1fe4ea0b448c7284d3d1a838b, type: 3}
    - {fileID: 2800000, guid: ffb940b2aa3e2464daa9b5fdf0bb1a03, type: 3}
    - {fileID: 2800000, guid: 54ec9d55e80bf3b4db6ffee56c449878, type: 3}
  - inicio: 177
    fim: 186
    setor: "LABORAT\xD3RIO"
    titulo: "Sa\xEDda de vapor"
    dica: O bocal avisa antes de soltar vapor. Fique fora da grade, espere o jato parar e siga.
    assunto: 0
    quadros: []
  - inicio: 186
    fim: 218
    setor: "CONTEN\xC7\xC3O"
    titulo: Guarda socador
    dica: "Esse corre para encurtar a dist\xE2ncia. D\xEA espa\xE7o para tr\xE1s quando ele levantar os punhos."
    assunto: 0
    quadros:
    - {fileID: 2800000, guid: 0c2b815fbf3a87347a4c69718572bd2f, type: 3}
    - {fileID: 2800000, guid: c215ef9a531b73248bffacb50715bcf2, type: 3}
