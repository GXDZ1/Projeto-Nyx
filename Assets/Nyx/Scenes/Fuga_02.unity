    - {fileID: 2800000, guid: 7967c3d4c8ec01f47adf8aaff04075f3, type: 3}
  - inicio: 254
    fim: 273.5
    setor: "DOCA DE EVACUA\xC7\xC3O"
    titulo: "Tanque de \xE1cido"
    dica: "Abra um portal na placa junto ao tanque e outro no teto do outro lado. Use <b>Q</b> se a pistola estiver na m\xE3o."
    assunto: 0
    quadros: []
  - inicio: 273.5
    fim: 284
    setor: "DOCA DE EVACUA\xC7\xC3O"
    titulo: "Sa\xEDda \xE0 vista"
    dica: Aproxime-se da porta e aperte <b>E</b> para sair da ala.
    assunto: 0
    quadros: []
