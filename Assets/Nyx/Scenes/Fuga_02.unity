  trechos:
  - inicio: 64
    fim: 74
    setor: TRIAGEM
    titulo: "Uma pistola no ch\xE3o"
    dica: "Chegue perto dela e pressione <b>E</b>. O invent\xE1rio no canto mostra qual ferramenta est\xE1 na m\xE3o."
    assunto: 5
    quadros:
    - {fileID: 2800000, guid: 133b0518b9f5aa641bdd3e91bd586ac5, type: 3}
