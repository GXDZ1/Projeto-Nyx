    - {fileID: 2800000, guid: acaf2e42ca56a624e80c4f985f516b31, type: 3}
  - inicio: 94.8
    fim: 103
    setor: TRIAGEM
    titulo: "Espinhos retr\xE1teis"
    dica: Espere as pontas baixarem. Atravesse o trecho de uma vez, antes que elas subam.
    assunto: 0
    quadros: []
  - inicio: 103
    fim: 136.5
    setor: "VIGIL\xC2NCIA"
    titulo: Pistoleiro
    dica: "Use a caixa como cobertura. As placas brancas do piso tamb\xE9m permitem sair pelo outro lado do guarda."
    assunto: 0
    quadros:
    - {fileID: 2800000, guid: ca284ce92a3065a4792d9b1407ee58a0, type: 3}
    - {fileID: 2800000, guid: 2fbafe237bc0d974d958749829c4e1bc, type: 3}
    - {fileID: 2800000, guid: 8676d5629c0d1e64bb9278ac20fc5b19, type: 3}
